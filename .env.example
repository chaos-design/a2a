# Agent identity and advertised endpoint
A2A_AGENT_ID=agent://local
A2A_AGENT_NAME=Local A2A Agent
A2A_AGENT_DESCRIPTION=Local development agent
A2A_ENDPOINT=http://127.0.0.1:4310

# HTTP listener. A2A_LISTEN_PORT may be 0 for an ephemeral test port.
A2A_LISTEN_HOST=127.0.0.1
A2A_LISTEN_PORT=4310

# Comma-separated protocol options
A2A_TRANSPORTS=http
A2A_CONTENT_TYPES=application/json

# Message and session limits
A2A_MAX_MESSAGE_BYTES=1048576
A2A_MAX_TTL_MS=300000
A2A_ALLOWED_CLOCK_SKEW_MS=30000
A2A_CHALLENGE_TTL_MS=30000
A2A_SESSION_TTL_MS=900000

# Production deployments should point to an Ed25519 PKCS#8 PEM file.
# Relative paths are resolved from the directory containing this .env file.
A2A_SIGNING_KEY_ID=
A2A_SIGNING_PRIVATE_KEY_FILE=
